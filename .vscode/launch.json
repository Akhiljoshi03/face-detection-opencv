{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Face Detection (webcam)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Face Detection (camera 1)",
